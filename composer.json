{
    "name": "software-technologies-limited/stl-rich-text-editor",
    "description": "A standalone, framework-agnostic rich text editor for PHP applications.",
    "type": "library",
    "keywords": ["software-technologies-limited", "stl", "php", "rich-text-editor", "wysiwyg", "laravel", "symfony", "yii", "editor"],
    "homepage": "https://github.com/software-technologies-limited/stl-rich-text-editor",
    "license": "BSD-3-Clause",
    "authors": [
        {"name": "Software Technologies Limited", "homepage": "https://github.com/software-technologies-limited", "role": "Maintainer"},
        {"name": "2amigOS! Consulting Group", "homepage": "https://github.com/2amigos", "role": "Original project developer"}
    ],
    "support": {
        "issues": "https://github.com/software-technologies-limited/stl-rich-text-editor/issues",
        "source": "https://github.com/software-technologies-limited/stl-rich-text-editor"
    },
    "require": {"php": "^8.1"},
    "suggest": {"illuminate/support": "Enables Laravel asset and configuration publishing."},
    "autoload": {"psr-4": {"Stl\\RichTextEditor\\": "src/"}},
